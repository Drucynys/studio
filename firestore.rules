rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // PUBLIC DATA: Allow anyone to read public data collections
    match /pokemon-tcg-sets/{setId} {
      allow read: if true;
      allow write: if false; // Only admin should write
    }
    match /pokemon-tcg-cards/{cardId} {
      allow read: if true;
      allow write: if false; // Only admin should write
    }
    match /pokemon-tcg-artists/{artistId} {
      allow read: if true;
      allow write: if false; // Only admin should write
    }
    match /pokedex/{pokemonId} {
      allow read: if true;
      allow write: if false; // Only admin should write
    }

    // USER DATA:
    // A user document can be created by a new authenticated user.
    // A user can only read or update their own profile document.
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read, update: if request.auth.uid == userId;
      
      // CARDS SUBCOLLECTION:
      // A user can perform any action on cards (create, read, update, delete)
      // only within their own user document.
      match /cards/{cardId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
  }
}
