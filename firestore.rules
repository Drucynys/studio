
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: These rules are permissive and are intended for initial development.
    // They allow anyone to read and write to your entire database.
    // You should secure your database with more specific rules before production.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
