rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Public data collections are read-only for everyone
    match /pokemon-tcg-sets/{setId} {
      allow read: if true;
    }
    match /pokemon-tcg-cards/{cardId} {
      allow read: if true;
    }
     match /pokemon-tcg-artists/{artistId} {
      allow read: if true;
    }
     match /pokedex/{pokemonId} {
      allow read: if true;
    }


    // User-specific data
    match /users/{userId} {
      // A user can create their own profile document.
      allow create: if isOwner(userId);
      
      // A user can read or update their own profile document.
      allow read, update: if isOwner(userId);
      
      // Subcollection for user's cards
      match /cards/{cardId} {
        // Allow read/write to the cards subcollection only if the requesting user
        // owns the parent user document. This is the key security rule.
        allow read, write: if isOwner(userId);
      }
    }
  }
}
