
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public data collections are read-only for all users.
    // This data is managed by server-side admin/sync scripts.
    match /pokedex/{doc=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /pokemon-tcg-artists/{doc=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /pokemon-tcg-cards/{doc=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /pokemon-tcg-sets/{doc=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // User data is private and can only be accessed by the authenticated user.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      
      // A user can manage their own card collection.
      match /cards/{cardId} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // A user can manage their own notifications.
      match /notifications/{notificationId} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // A user can manage the list of people they follow.
      match /following/{targetUserId} {
        allow read, write: if request.auth.uid == userId;
      }
      
      // A user can see who follows them, but cannot add/remove followers directly.
      // This is handled by the server (API/Cloud Function).
      match /followers/{followerId} {
         allow read: if request.auth.uid == userId;
         allow write: if false; 
      }
    }
  }
}
