
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public data is read-only for anyone
    match /pokemon-tcg-sets/{set=**} { allow read: if true; allow write: if false; }
    match /pokemon-tcg-cards/{card=**} { allow read: if true; allow write: if false; }
    match /pokemon-tcg-artists/{artist=**} { allow read: if true; allow write: if false; }
    match /pokedex/{pokemon=**} { allow read: if true; allow write: if false; }

    // User-specific data
    match /users/{userId} {
      // A user can read their own top-level user document, but not write to it directly.
      allow get: if request.auth.uid == userId;

      // Rules for the user's profile subcollection
      match /profile/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Rules for the user's card collection
      match /cards/{cardId} {
        // A user can read, create, update, and delete cards in their own collection.
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
