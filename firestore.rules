rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read public profiles but only write to their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth.uid == userId;

      // Collection data is private by default
      match /cards/{cardId} {
        allow read, create, update, delete: if request.auth.uid == userId;
      }
      
      // Following/Followers lists can be written to by authenticated users
      // to establish the relationship.
      match /following/{targetId} {
        allow read, create, delete: if request.auth.uid == userId;
      }
      match /followers/{followerId} {
        allow read, create, delete: if request.auth.uid == followerId || request.auth.uid == userId;
      }
      
      // Notifications can only be read, created (by functions), and updated by the owner
      match /notifications/{notificationId} {
        allow read, update, create: if request.auth.uid == userId;
      }
    }

    // Public collections that can be read by anyone
    match /pokemon-tcg-sets/{setId} {
      allow read: if true;
      allow write: if false; // Only server-side sync can write
    }
    match /pokemon-tcg-cards/{cardId} {
      allow read: if true;
      allow write: if false; // Only server-side sync can write
    }
    match /pokemon-tcg-artists/{artistId} {
      allow read: if true;
      allow write: if false; // Only server-side sync can write
    }
    match /pokedex/{pokemonId} {
        allow read: if true;
        allow write: if false; // Only sync can write
    }
  }
}
