rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // USERS COLLECTION
    // Allow reading of public user profiles by anyone.
    // Allow authenticated users to create and update their own profile.
    match /users/{userId} {
      allow get: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // CARDS SUBCOLLECTION
    // Authenticated users can only read and write to their own card collection.
    match /users/{userId}/cards/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // FOLLOWING SUBCOLLECTION
    // Authenticated users can manage their own list of who they follow.
    match /users/{userId}/following/{targetId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // FOLLOWERS SUBCOLLECTION
    // Authenticated users can see who follows them.
    // Writes are handled by the backend API and are disallowed from the client.
    match /users/{userId}/followers/{followerId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Explicitly deny client-side writes
    }
  }
}
