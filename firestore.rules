
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public data is read-only for all users
    match /pokedex/{pokemonId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /pokemon-tcg-artists/{artistId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /pokemon-tcg-cards/{cardId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /pokemon-tcg-sets/{setId} {
      allow read: if true;
      allow write: if false;
    }
    
    // User data is private to the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User's card collection
      match /cards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's follow lists
      match /following/{targetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /followers/{followerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
