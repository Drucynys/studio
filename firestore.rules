rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- TEMPORARY DEBUGGING RULE ---
    // This rule allows any authenticated user to read and write to the entire database.
    // This helps determine if the issue is with security rules or client-side configuration.
    // IMPORTANT: This is NOT secure for production. We will replace this once the issue is resolved.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // --- Public Read Rules (Still in effect) ---
    // These are safe and allow anyone to view public data.
    match /pokemon-tcg-sets/{set} {
      allow read: if true;
    }
    match /pokemon-tcg-cards/{card} {
      allow read: if true;
    }
    match /pokemon-tcg-artists/{artist} {
        allow read: if true;
    }
    match /pokedex/{pokemon} {
        allow read: if true;
    }
  }
}
