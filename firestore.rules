
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write only their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public data (like sets, cards, artists) should be readable by anyone
    match /pokemon-tcg-sets/{setId} {
      allow read: if true;
      allow write: if false; // Only updatable via admin/server functions
    }
    match /pokemon-tcg-cards/{cardId} {
      allow read: if true;
      allow write: if false; // Only updatable via admin/server functions
    }
    match /pokemon-tcg-artists/{artistId} {
      allow read: if true;
      allow write: if false; // Only updatable via admin/server functions
    }
    match /pokedex/{pokemonId} {
      allow read: if true;
      allow write: if false; // Only updatable via admin/server functions
    }
  }
}
